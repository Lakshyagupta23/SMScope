# SecureMailScope Backend - Environment Configuration
# =====================================================

# IPS Enforcement Mode
# 0 = LIVE enforcement (actual netsh/iptables firewall rules will be executed)
# 1 = DRY_RUN (safe simulation - no OS firewall changes, only logging)
IPS_DRY_RUN=1

# Server
HOST=0.0.0.0
PORT=8000

# Optional: SMTP Configuration for SOC Alerts
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=yourpassword
# SMTP_FROM=securemailscope@yourorg.com
# SMTP_TO=soc-team@yourorg.com

# Optional: VirusTotal API Key for live CTI lookups
# VIRUSTOTAL_API_KEY=your_key_here

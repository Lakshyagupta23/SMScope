# Frontend .dockerignore
# Prevents host-side artifacts from being copied into the Docker image.
# This is critical: host node_modules may contain Windows-compiled native
# bindings that are incompatible with the Linux container.

node_modules/
dist/
.git/
.gitignore
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
*.swp
*.swo
.env.local
.env.*.local
.vscode/
.idea/
coverage/
